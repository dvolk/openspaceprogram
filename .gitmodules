[submodule "middleware/glm"]
	path = middleware/glm
	url = https://github.com/g-truc/glm
[submodule "middleware/bullet3"]
	path = middleware/bullet3
	url = https://github.com/bulletphysics/bullet3
	# bootstrap.sh adds a bullet -> src symlink (untracked, needed for the
	# <bullet/...> includes) -- keep it out of the superproject's status.
	ignore = untracked
[submodule "middleware/imgui"]
	path = middleware/imgui
	url = https://github.com/ocornut/imgui
[submodule "middleware/implot"]
	path = middleware/implot
	url = https://github.com/epezent/implot
[submodule "middleware/assimp"]
	path = middleware/assimp
	url = https://github.com/assimp/assimp
[submodule "middleware/sdl3"]
	path = middleware/sdl3
	url = https://github.com/libsdl-org/SDL
[submodule "middleware/sdl3-image"]
	path = middleware/sdl3-image
	url = https://github.com/libsdl-org/SDL_image
[submodule "middleware/sdl-mixer"]
	path = middleware/sdl-mixer
	url = https://github.com/libsdl-org/SDL_mixer
