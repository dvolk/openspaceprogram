# rcs_box: a plain cube, 0.3m on a side, centered at the part origin.
# Solid-gray texture (textures/rcs_box.png). Visual only -- the collision hull
# comes from the PartDef radius/height. The part's +X is the face away from a
# surface mount (the srf node points -X, #428); nozzles live on the 5 exposed
# faces, not the mount.
# Faces are CCW seen from outside; each vn matches its winding's normal.
o rcs_box
v -0.15 -0.15 -0.15
v  0.15 -0.15 -0.15
v  0.15  0.15 -0.15
v -0.15  0.15 -0.15
v -0.15 -0.15  0.15
v  0.15 -0.15  0.15
v  0.15  0.15  0.15
v -0.15  0.15  0.15
vn 0 0 -1
vn 0 0 1
vn -1 0 0
vn 1 0 0
vn 0 -1 0
vn 0 1 0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
f 4/1/1 3/2/1 2/3/1 1/4/1
f 6/1/2 7/2/2 8/3/2 5/4/2
f 1/1/3 5/2/3 8/3/3 4/4/3
f 3/1/4 7/2/4 6/3/4 2/4/4
f 1/1/5 2/2/5 6/3/5 5/4/5
f 4/1/6 8/2/6 7/3/6 3/4/6
