# rcs_box: a plain cube, 0.8m across, 0.5m tall, centered at the part origin.
# Solid-gray texture (textures/rcs_box.png). Visual only -- the collision hull
# comes from the PartDef radius/height. Local +Z is the face away from the
# mount; the -Z face is the mount face (no nozzle there, #428).
o rcs_box
v -0.4 -0.4 -0.25
v  0.4 -0.4 -0.25
v  0.4  0.4 -0.25
v -0.4  0.4 -0.25
v -0.4 -0.4  0.25
v  0.4 -0.4  0.25
v  0.4  0.4  0.25
v -0.4  0.4  0.25
vn 0 0 -1
vn 0 0 1
vn -1 0 0
vn 1 0 0
vn 0 -1 0
vn 0 1 0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/1/2 8/2/2 7/3/2 6/4/2
f 1/1/3 5/2/3 8/3/3 4/4/3
f 2/1/4 6/2/4 7/3/4 3/4/4
f 1/1/5 2/2/5 6/3/5 5/4/5
