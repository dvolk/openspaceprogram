# Parachute canopy (placeholder): a 1x1 m flat quad in the XY plane,
# centered on the origin (+Z = the part's stack axis). Drawn double-sided
# (two face winding orders) so the canopy reads from above and below.
# Scaled by sqrt(chute_area) and offset above the part at draw time
# (Vehicle::Draw); never a collision shape.
v -0.5 -0.5 0.0
v  0.5 -0.5 0.0
v  0.5  0.5 0.0
v -0.5  0.5 0.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 4/4/2 3/3/2 2/2/2
f 4/4/2 2/2/2 1/1/2
