# Build artifacts
obj/
obj_test/
obj_asan/
osp
osp_asan
obj_tsan/
osp_tsan
# GLEW: the official git repo ships only the code *generator* (glew.c is
# generated from the Khronos registry), so bootstrap.sh fetches the
# official 2.2.0 source tarball instead and extracts it here.
middleware/glew/

# Test binaries at repo root (the tests/ sources stay tracked)
/test_*

# Runtime-generated
imgui.ini
settings.json

# Audio assets: kept local until we've listened to them in game and decided
# (the res/*.ogg + res/*.mp3 are the unconverted OpenGameArt sources; the
# res/*.wav are the SFX in final form)
res/*.wav
res/*.ogg
res/*.mp3

# Generated by `make version` (first build) from git state
src/version.h

# Python bytecode (from the utils/ scripts)
__pycache__/

# Local reference material & screenshots
references/
screenshot_*.png
tmp/

# Source data (baked into the tracked ksp_system.json)
ksp_system.csv

# KSP parts wiki scrape (utils/gen_parts_wiki.py output; re-run to refresh)
utils/parts_wiki/

# bear -- make
compile_commands.json
