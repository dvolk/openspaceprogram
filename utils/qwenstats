def parse_date(s):
    try:
        return dt.date.fromisoformat(s)
    except ValueError:
        raise argparse.ArgumentTypeError(f"expected YYYY-MM-DD, got {s!r}")


def positive_int(s):
    try:
        v = int(s)
    except ValueError:
        raise argparse.ArgumentTypeError(f"expected an integer, got {s!r}")
    if v < 1:
        raise argparse.ArgumentTypeError("expected a row count of 1 or more")
    return v


def main():
    ap = argparse.ArgumentParser(prog="qstats", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--by", choices=["overview", "model", "day", "week", "month", "project",
                                     "tools", "sources", "heatmap", "unmapped", "suggest"],
                                     help="print only this section (default: overview, model, "
                                          "week, heatmap, project, tools, sources)")
    ap.add_argument("--since", type=parse_date, help="inclusive YYYY-MM-DD")
    ap.add_argument("--until", type=parse_date, help="inclusive YYYY-MM-DD")
    ap.add_argument("--project", help="substring filter on project path")
    ap.add_argument("--model", help="substring filter on raw or canonical model name")
    ap.add_argument("--source", choices=["main", "subagent", "all"], default="all")
    ap.add_argument("--limit", type=positive_int, default=15,
                    help="rows for the model/project/tools tables (default 15); timeline, "
                         "sources, heatmap and mapping sections always print in full")
    ap.add_argument("--raw", action="store_true", help="disable all model grouping")
    ap.add_argument("--no-members", action="store_true", help="hide the rolled-up alias legend")
    ap.add_argument("--groups", default=None, help="alias file (default <qwen-dir>/model_groups.json)")
    ap.add_argument("--qwen-dir", default=QWEN_DIR)
    args = ap.parse_args()

    qwen = os.path.expanduser(args.qwen_dir)
    if not os.path.isdir(qwen):
        ap.error(f"no such qwen directory: {qwen}")
    groups = args.groups or os.path.join(qwen, GROUPS_FILE)
    if args.groups and not os.path.exists(groups):
        print(f"warning: alias file {groups} does not exist; falling back to auto-normalisation",
              file=sys.stderr)
    folder = Folder(groups, enabled=not args.raw)

    sessions, bad_sessions = load_sessions(os.path.join(qwen, "usage_record.jsonl"),
                                           args.since, args.until)
    reqs, dupes, bad_reqs = load_requests(os.path.join(qwen, "usage", "*.jsonl"),
                                          args.since, args.until, folder)
    bad = bad_sessions + bad_reqs

    # Every filter is applied to the request stream; the session-scoped sections then
    # follow the surviving sessions so no two tables can disagree.
    scoped = bool(args.project or args.source != "all" or args.model)
    if args.source != "all":
        want = args.source == "main"
        reqs = [r for r in reqs if (r["source"] == "main") == want]
    if args.model:
        needle = args.model.lower()
        reqs = [r for r in reqs if needle in r["model"].lower() or needle in r["raw_model"].lower()]
    if args.project:
        needle = args.project.lower()
        reqs = [r for r in reqs
                if needle in (sessions[r["session"]].project if r["session"] in sessions else "").lower()]
    if scoped:
        owning = {r["session"] for r in reqs}
        sessions = {sid: s for sid, s in sessions.items() if sid in owning}

    print(f"# qstats  {args.since or '(start)'} .. {args.until or '(latest)'}\n")
    if args.since or args.until or scoped:
        print("note: session wall time, lines and tool counts are per-session totals for the\n"
              "sessions in view (usage_record has no per-model or per-source split), while\n"
              "requests and tokens are counted per request.\n")

    all_sections = ["overview", "model", "week", "heatmap", "project", "tools", "sources"]
    wanted = [args.by] if args.by else all_sections

    if "overview" in wanted:
        print("## overview\n")
        sec_overview(reqs, sessions, dupes, bad)
        print()
    if "model" in wanted:
        print("## models\n")
        sec_models(reqs, folder, args.limit, not args.no_members)
        print()
    for unit in ("day", "week", "month"):
        if unit in wanted:
            print(f"## by {unit}\n")
            sec_timeline(reqs, unit)
            print()
    if "heatmap" in wanted:
        print("## activity heatmap\n")
        sec_heatmap(reqs)
        print()
    if "project" in wanted:
        print("## projects\n")
        sec_projects(reqs, sessions, args.limit)
        print()
    if "tools" in wanted:
        print("## tools\n")
        sec_tools(sessions, args.limit)
        print()
    if "sources" in wanted:
        print("## request sources\n")
        sec_sources(reqs)
        print()
    if "unmapped" in wanted:
        print("## model name mapping\n")
        sec_unmapped(reqs, folder)
        print()
    if "suggest" in wanted:
        print("## suggested merges\n")
        sec_suggest(reqs, folder)
        print()


if __name__ == "__main__":
    main()
