def parse_ts(value):
    if isinstance(value, str):
        d = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    else:
        d = dt.datetime.fromtimestamp(value / 1000, dt.timezone.utc)
    return d.astimezone()


class Session:
    __slots__ = ("project", "duration_ms", "lines_add", "lines_del", "tools",
                 "segments", "in_window", "snap_ts")

    def __init__(self):
        self.project = "(unknown)"
        self.duration_ms = 0
        self.lines_add = 0
        self.lines_del = 0
        self.tools = {}
        self.segments = 0
        self.in_window = False
        self.snap_ts = None

    def take_snapshot(self, when, files, tool_map):
        """Each resumed segment re-emits the whole session total, so the newest
        snapshot IS the session total; summing segments double counts."""
        if self.snap_ts is None or when >= self.snap_ts:
            self.snap_ts = when
            self.lines_add = files.get("linesAdded") or 0
            self.lines_del = files.get("linesRemoved") or 0
            self.tools = {name: [st.get("count") or 0, st.get("fail") or 0,
                                 st.get("totalDurationMs") or 0]
                          for name, st in tool_map.items()}
        else:
            # Out-of-order segment: only lift fields that actually increased.
            self.lines_add = max(self.lines_add, files.get("linesAdded") or 0)
            self.lines_del = max(self.lines_del, files.get("linesRemoved") or 0)
            for name, st in tool_map.items():
                slot = self.tools.setdefault(name, [0, 0, 0])
                slot[0] = max(slot[0], st.get("count") or 0)
                slot[1] = max(slot[1], st.get("fail") or 0)
                slot[2] = max(slot[2], st.get("totalDurationMs") or 0)


def load_sessions(path, since, until):
    """One entry per sessionId. Every segment contributes its project (so requests
    in the window still join to a project even when the session started earlier),
    but stats only come from in-window segments."""
    sessions = {}
    bad = 0
    if not os.path.exists(path):
        return sessions, bad
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                bad += 1
                continue
            if not isinstance(rec, dict) or not rec.get("sessionId"):
                bad += 1
                continue
            try:
                when = parse_ts(rec.get("startTime") or rec.get("timestamp"))
            except (TypeError, ValueError):
                bad += 1
                continue
            s = sessions.setdefault(rec["sessionId"], Session())
            if rec.get("project"):
                s.project = rec["project"]
            if (since and when.date() < since) or (until and when.date() > until):
                continue
            s.segments += 1
            s.in_window = True
            # durationMs is the only per-segment field; everything else is cumulative.
            s.duration_ms += rec.get("durationMs") or 0
            s.take_snapshot(when, rec.get("files") or {},
                            (rec.get("tools") or {}).get("byName") or {})
    return sessions, bad


def load_requests(dir_glob, since, until, folder):
    reqs = []
    seen_ids = set()
    dupes = bad = 0
    for path in sorted(glob.glob(dir_glob)):
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    bad += 1
                    continue
                if not isinstance(rec, dict) or "timestamp" not in rec:
                    bad += 1
                    continue
                rid = rec.get("id")
                if rid is not None:
                    if rid in seen_ids:
                        dupes += 1
                        continue
                    seen_ids.add(rid)
                try:
                    when = parse_ts(rec["timestamp"])
                except (TypeError, ValueError):
                    bad += 1
                    continue
                if since and when.date() < since:
                    continue
                if until and when.date() > until:
                    continue
                raw = rec.get("model") or "?"
                reqs.append({
                    "when": when,
                    "session": rec.get("sessionId"),
                    "source": rec.get("source") or "?",
                    "raw_model": raw,
                    "model": folder.canonical(raw),
                    "in": rec.get("inputTokens") or 0,
                    "out": rec.get("outputTokens") or 0,
                    "cached": rec.get("cachedTokens") or 0,
                    "think": rec.get("thoughtsTokens") or 0,
                    "total": rec.get("totalTokens") or 0,
                    "ms": rec.get("apiDurationMs") or 0,
                })
    return reqs, dupes, bad


# ----------------------------------------------------------------------------
# formatting
# ----------------------------------------------------------------------------

def num(v):
    if v is None:
        return "-"
    a = abs(v)
    if a >= 1e9:
        return f"{v / 1e9:.2f}G"
    if a >= 1e6:
        return f"{v / 1e6:.2f}M"
    if a >= 1e4:
        return f"{v / 1e3:.0f}k"
    return f"{v:,.0f}"


def hours(ms):
    if ms >= 3.6e8:
        return f"{ms / 3.6e6:.0f}h"
    if ms >= 3.6e6:
        return f"{ms / 3.6e6:.1f}h"
    if ms >= 6e4:
        return f"{ms / 6e4:.1f}m"
    return f"{ms / 1e3:.1f}s"


def pct(part, whole):
    return "-" if not whole else f"{100.0 * part / whole:.1f}%"


def short_path(p, width=46):
    home = os.path.expanduser("~")
    if p.startswith(home + "/"):
        p = "~/" + p[len(home) + 1:]
    return p if len(p) <= width else "..." + p[-(width - 3):]


def table(rows, headers):
    return tabulate(rows, headers=headers, tablefmt="rounded_outline",
                    disable_numparse=True, stralign="right")


def percentile(values, q):
    if not values:
        return None
    values = sorted(values)
    pos = (len(values) - 1) * q
    lo = int(pos)
    hi = min(lo + 1, len(values) - 1)
    return values[lo] + (values[hi] - values[lo]) * (pos - lo)


def ms_str(values, q):
    v = percentile(values, q)
    return "-" if v is None else f"{v:.0f}"


