#!/home/ubuntu/.venvs/qstats/bin/python3
"""qstats - personal usage stats for Qwen Code CLI logs in ~/.qwen.

Sources:
  ~/.qwen/usage/token-usage-YYYY-MM.jsonl  one record per API request (model, tokens, latency)
  ~/.qwen/usage_record.jsonl               one record per session segment (project, tools, line deltas)

The token log has no project field, so project attribution comes from joining
sessionId -> usage_record.

Model names are folded onto one row each by ~/.qwen/model_groups.json (explicit
rules) and then by stripping paths, .gguf and quant suffixes. Run
`qstats --by unmapped` to see names still on the fallback and `qstats --by suggest`
for likely merges. No pricing exists in these logs, so this reports tokens,
latency and throughput rather than cost.
"""

import argparse
import collections
import datetime as dt
import fnmatch
import glob
import json
import os
import re
import sys

try:
    from tabulate import tabulate
except ModuleNotFoundError:
    sys.exit("qstats needs tabulate. Run it with the venv interpreter "
             "(~/.venvs/qstats/bin/python3), or make one: "
             "python3 -m venv ~/.venvs/qstats && ~/.venvs/qstats/bin/pip install tabulate")

QWEN_DIR = os.path.expanduser(os.environ.get("QWEN_DIR", "~/.qwen"))
GROUPS_FILE = "model_groups.json"

# ----------------------------------------------------------------------------
# model name canonicalisation
# ----------------------------------------------------------------------------

# Trailing quant/build decorations that llama.cpp-style model ids accumulate.
# Deliberately excludes it/instruct/chat: "llama3-8b-it" and "llama3-8b" are
# different models, so stripping those would fabricate a merge.
VARIANT_WORDS = r"(?:ud|expert|generic|mainline)"
# A quant always carries an underscore group (Q4_K_M, Q8_0, IQ3_XXS) or an iq
# prefix; that keeps "k2"/"k1"/bare "q4" intact instead of eating a model name.
QUANT_TOKEN = r"(?:iq[0-9]+(?:_[a-z0-9]+)*|q[0-9]+(?:_[a-z0-9]+)+)"
QUANT_RE = re.compile(
    rf"""(?i)
    (?:
        [._\-\s]+ {VARIANT_WORDS} [._\-\s]+ {QUANT_TOKEN}
      | [._\-\s]+ {VARIANT_WORDS}
      | [._\-\s]+ {QUANT_TOKEN}
    ) $""",
    re.VERBOSE,
)
VERSION_RE = re.compile(r"[0-9]+(?:\.[0-9]+)+")
PATHISH_RE = re.compile(r"\.(gguf|safetensors|bin|ggml)$", re.I)


def normalize_model(name):
    """'stuff/software/models/Qwen3.8-27B-Q4_K_M.gguf' -> 'Qwen3.8-27B'"""
    orig = name.strip()
    n = orig
    if PATHISH_RE.search(n) or "/" in n or "\\" in n:
        n = os.path.basename(n)
    n = PATHISH_RE.sub("", n)
    prev = None
    while prev != n:
        prev = n
        n = QUANT_RE.sub("", n).rstrip("._- ")
    # If stripping gutted the identifier ("A-Q4_0" -> "A"), the match was part of
    # the name rather than a decoration, so keep the original.
    if len(n) < 3 or not re.search(r"[a-z]{2}", n, re.I):
        return orig
    return n


def suggest_key(name):
    """Coarser signature (no version numbers, no quants) used only for --by suggest."""
    base = normalize_model(name).lower()
    base = VERSION_RE.sub(" ", base)
    return " ".join(sorted({t for t in re.split(r"[^a-z0-9]+", base) if len(t) > 1}))


class Folder:
    """Maps raw model names onto canonical families via an editable alias file."""

    def __init__(self, path, enabled=True):
        self.raw = not enabled
        self.path = path
        self.explicit = {}
        self.loaded = False
        if not self.raw and os.path.exists(path):
            try:
                with open(path) as fh:
                    cfg = json.load(fh)
            except (json.JSONDecodeError, OSError) as exc:
                print(f"warning: ignoring {path}: {exc}", file=sys.stderr)
                cfg = {}
            groups = cfg.get("groups") or {}
            if not isinstance(groups, dict):
                print(f"warning: {path}: \"groups\" must map display name -> list of raw names, ignored",
                      file=sys.stderr)
                groups = {}
            claimed = {}
            for canon, patterns in groups.items():
                if isinstance(patterns, str):
                    patterns = [patterns]
                if not isinstance(patterns, list):
                    print(f"warning: {path}: rule for {canon!r} is not a name or list, skipped",
                          file=sys.stderr)
                    continue
                for pat in patterns:
                    low = str(pat).strip().lower()
                    if low in claimed and claimed[low] != canon:
                        print(f"warning: {path}: {pat!r} is mapped to both {claimed[low]!r} and "
                              f"{canon!r}; using {canon!r}", file=sys.stderr)
                    claimed[low] = canon
                    self.explicit[low] = canon
            self.loaded = True

    def _match(self, low):
        if low in self.explicit:
            return self.explicit[low]
        for pat, canon in self.explicit.items():
            if ("*" in pat or "?" in pat) and fnmatch.fnmatch(low, pat):
                return canon
        return None

    def canonical(self, name):
        if self.raw:
            return name
        hit = self._match(name.strip().lower())
        if hit:
            return hit
        norm = normalize_model(name)
        return self._match(norm.lower()) or norm

    def is_explicit(self, name):
        return (self._match(name.strip().lower()) is not None
                or self._match(normalize_model(name).lower()) is not None)


