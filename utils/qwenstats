def sec_overview(reqs, sessions, dupes, bad):
    if not reqs and not sessions:
        print("no records in range")
        return
    dates = {r["when"].date() for r in reqs}
    tin = sum(r["in"] for r in reqs)
    tout = sum(r["out"] for r in reqs)
    api_ms = sum(r["ms"] for r in reqs)
    main = sum(1 for r in reqs if r["source"] == "main")
    rows = [
        ["span", (f"{min(dates)} .. {max(dates)} ({len(dates)} active days)" if dates else "-")],
        ["sessions", f"{len({r['session'] for r in reqs}):,}"],
        ["api requests", f"{len(reqs):,}"],
        ["requests / active day", f"{len(reqs) / max(1, len(dates)):,.0f}"],
        ["tokens total", num(sum(r["total"] for r in reqs))],
        # totalTokens == input+output, so thinking is a subset of completion.
        ["prompt / completion", f"{num(tin)} / {num(tout)} (thinking {num(sum(r['think'] for r in reqs))})"],
        ["cache hit rate", pct(sum(r["cached"] for r in reqs), tin)],
        ["api time", f"{hours(api_ms)}  (p50 {ms_str([r['ms'] for r in reqs], .5)}ms / "
                     f"p95 {ms_str([r['ms'] for r in reqs], .95)}ms)"],
        ["session wall time", hours(sum(s.duration_ms for s in sessions.values()))],
        ["main / subagent", f"{main:,} / {len(reqs) - main:,} "
                            f"({pct(len(reqs) - main, len(reqs))} from subagents)"],
        ["lines + / -", f"{sum(s.lines_add for s in sessions.values()):,} / "
                        f"{sum(s.lines_del for s in sessions.values()):,}"],
    ]
    if dupes:
        rows.append(["skipped duplicate ids", f"{dupes:,}"])
    if bad:
        rows.append(["skipped unparsable lines", f"{bad:,}"])
    print(table(rows, ["", "total"]))


def sec_models(reqs, folder, limit, show_members):
    agg = collections.defaultdict(lambda: {"req": 0, "in": 0, "out": 0, "think": 0,
                                           "cached": 0, "total": 0, "ms": [],
                                           "first": None, "last": None,
                                           "raw": collections.Counter()})
    for r in reqs:
        a = agg[r["model"]]
        a["req"] += 1
        for k in ("in", "out", "think", "cached", "total"):
            a[k] += r[k]
        a["ms"].append(r["ms"])
        a["raw"][r["raw_model"]] += 1
        if a["first"] is None or r["when"] < a["first"]:
            a["first"] = r["when"]
        if a["last"] is None or r["when"] > a["last"]:
            a["last"] = r["when"]

    ranked = sorted(agg.items(), key=lambda kv: -kv[1]["total"])
    rows = []
    for name, a in ranked[:limit]:
        ms = a["ms"]
        rows.append([
            name, a["req"], num(a["in"]), num(a["out"]), num(a["think"]),
            pct(a["cached"], a["in"]), num(a["total"]),
            ms_str(ms, .5), ms_str(ms, .95),
            num(a["out"] / (sum(ms) / 1000.0)) if sum(ms) else "-",
            f"{a['first'].date()}..{a['last'].date()}",
        ])
    print(table(rows, ["model", "reqs", "prompt", "compl", "think", "cache%",
                       "total tok", "p50ms", "p95ms", "out tok/s", "seen"]))

    if show_members and not folder.raw:
        multi = [(n, a["raw"]) for n, a in ranked if len(a["raw"]) > 1]
        if multi:
            print("\nrolled up from:")
            for name, raw in multi:
                print(f"  {name}")
                for m, c in raw.most_common():
                    flag = "" if folder.is_explicit(m) else "   (auto)"
                    print(f"      {c:>7,}  {m}{flag}")


def sec_timeline(reqs, unit):
    def key(d):
        if unit == "day":
            return d.isoformat()
        if unit == "week":
            iso = d.isocalendar()
            return f"{iso[0]}-W{iso[1]:02d}"
        return d.strftime("%Y-%m")

    buckets = collections.defaultdict(lambda: {"req": 0, "tok": 0, "ms": 0, "sess": set()})
    for r in reqs:
        b = buckets[key(r["when"].date())]
        b["req"] += 1
        b["tok"] += r["total"]
        b["ms"] += r["ms"]
        b["sess"].add(r["session"])
    mx = max((b["tok"] for b in buckets.values()), default=1)
    rows = []
    for k in sorted(buckets):
        b = buckets[k]
        rows.append([k, len(b["sess"]), b["req"], num(b["tok"]), hours(b["ms"]),
                     "#" * max(1, int(34 * b["tok"] / mx))])
    print(table(rows, [unit, "sess", "reqs", "tokens", "api time", "tokens"]))


def sec_heatmap(reqs):
    grid = collections.Counter((r["when"].weekday(), r["when"].hour) for r in reqs)
    if not grid:
        return
    scale = " .:-=+*#%@"
    mx = max(grid.values())
    days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    header = [""] + [str(h) for h in range(24)]
    rows = []
    for wd in range(7):
        cells = []
        for h in range(24):
            v = grid.get((wd, h), 0)
            if not v:
                cells.append("-")
            else:
                lvl = max(1, min(len(scale) - 1, int((v / mx) * (len(scale) - 1) + 0.999)))
                cells.append(scale[lvl] * 3)
        rows.append([days[wd]] + cells)
    print(table(rows, header))
    print(f"requests per local weekday x hour; '-' = none, '{scale[-1]}' = peak ({mx}), "
          f"'{scale[1]}' = anything below the first of 10 count bands")


def sec_projects(reqs, sessions, limit):
    agg = collections.defaultdict(lambda: {"sess": set(), "req": 0, "tok": 0, "add": 0,
                                           "del": 0, "dur": 0, "tools": 0})
    # Session-scoped figures only come from segments inside the window...
    for sid, s in sessions.items():
        if not s.in_window:
            continue
        a = agg[s.project]
        a["sess"].add(sid)
        a["add"] += s.lines_add
        a["del"] += s.lines_del
        a["dur"] += s.duration_ms
        a["tools"] += sum(t[0] for t in s.tools.values())
    # ...but the project join uses every segment ever recorded for the session, so a
    # session that started before the window still attributes to its real project.
    for r in reqs:
        sid = r["session"]
        s = sessions.get(sid)
        a = agg[s.project if s is not None else "(no usage_record)"]
        a["req"] += 1
        a["tok"] += r["total"]
        a["sess"].add(sid)
    rows = []
    for name, a in sorted(agg.items(), key=lambda kv: -kv[1]["tok"])[:limit]:
        rows.append([short_path(name), len(a["sess"]), a["req"], num(a["tok"]),
                     hours(a["dur"]), f"+{a['add']:,}/-{a['del']:,}", a["tools"]])
    print(table(rows, ["project", "sess", "reqs", "tokens", "wall time", "lines", "tools"]))


def sec_tools(sessions, limit):
    calls = collections.defaultdict(lambda: [0, 0, 0])
    for s in sessions.values():
        for name, (n, fail, ms) in s.tools.items():
            c = calls[name]
            c[0] += n
            c[1] += fail
            c[2] += ms
    total = sum(c[0] for c in calls.values())
    rows = [[name, c[0], pct(c[0], total), c[1], pct(c[1], c[0]), hours(c[2]),
             hours(c[2] / c[0]) if c[0] else "-"]
            for name, c in sorted(calls.items(), key=lambda kv: -kv[1][0])[:limit]]
    print(table(rows, ["tool", "calls", "share", "fails", "fail%", "time", "avg"]) if rows
          else "no tool records in range")



def sec_sources(reqs):
    src = collections.defaultdict(lambda: {"req": 0, "tok": 0})
    for r in reqs:
        src[r["source"]]["req"] += 1
        src[r["source"]]["tok"] += r["total"]
    rows = [[k, v["req"], pct(v["req"], len(reqs)), num(v["tok"])]
            for k, v in sorted(src.items(), key=lambda kv: -kv[1]["req"])]
    print(table(rows, ["source", "reqs", "share", "tokens"]))


def sec_unmapped(reqs, folder):
    if folder.raw:
        print("grouping is disabled (--raw), so nothing is mapped; drop --raw to see this")
        return
    raw = collections.Counter(r["raw_model"] for r in reqs if not folder.is_explicit(r["raw_model"]))
    if not raw:
        print(f"every raw model name has an explicit rule in {folder.path}")
        return
    print(f"raw names relying on auto-normalisation (edit {folder.path} to merge these):")
    print(table([[m, c, folder.canonical(m)] for m, c in raw.most_common()],
                 ["raw name", "reqs", "-> group"]))


def versions_of(name):
    return set(VERSION_RE.findall(name.lower()))


def sec_suggest(reqs, folder):
    """Cluster raw names whose version/quant-stripped token sets overlap, so the
    alias file is easy to fill in. Suggestion only: never applied automatically."""
    by_key = collections.defaultdict(collections.Counter)
    for r in reqs:
        if folder.is_explicit(r["raw_model"]):
            continue  # already merged on purpose
        by_key[suggest_key(r["raw_model"]) or "(none)"][r["raw_model"]] += 1
    keys = [k for k in sorted(by_key) if k != "(none)"]

    pairs = []
    for i, a in enumerate(keys):
        for b in keys[i + 1:]:
            sa, sb = set(a.split()), set(b.split())
            shared = sa & sb
            # A single shared word ("coder") is not evidence of a rename.
            if len(shared) < 2:
                continue
            va = {v for n, _ in by_key[a].items() if versions_of(n)}
            vb = {v for n, _ in by_key[b].items() if versions_of(n)}
            if va and vb and va != vb:
                continue  # 3.8 vs 4.0 is a different model, not a rename
            pairs.append((a, b, shared))
    if not pairs:
        print("  (no unmapped names overlap once versions and quants are ignored)")
        return
    for a, b, shared in pairs:
        names = list(by_key[a].items()) + list(by_key[b].items())
        total = sum(c for _, c in names)
        vers = set()
        for n, _ in names:
            vers |= versions_of(n)
        print(f"  {total:>7,} reqs  share tokens: {', '.join(sorted(shared))}"
              f"{'  versions: ' + ', '.join(sorted(vers)) if vers else ''}")
        for name, count in sorted(names, key=lambda kv: -kv[1]):
            print(f"              {count:>7,}  {name}")
        # Distinct version numbers mean distinct models (3.8 vs 4.0), not a rename.
        distinct = {v for n, _ in names for v in versions_of(n)}
        per_name_versions = [versions_of(n) for n, _ in names if versions_of(n)]
        if len(distinct) > 1 and any(v != per_name_versions[0] for v in per_name_versions):
            print("      -> different version numbers, so probably genuinely distinct models")
            continue
        label = max(((normalize_model(n), c) for n, c in names), key=lambda kv: kv[1])[0]
        print(f"      paste into {GROUPS_FILE} if correct:")
        print(json.dumps({label: [n for n, _ in names]}, indent=2))


