#!/usr/bin/make -f

# Built by the project's own Makefile (bootstrap + make); override dh auto steps.
# Unit/e2e gates stay out of the .deb build (fast, no display).

# Release binary to package. Override with OSP_BIN=... for a different ISA build.
OSP_BIN ?= build/linux-v2-znver3/release/osp

%:
	dh $@

override_dh_auto_build:
	./bootstrap.sh
	make

override_dh_auto_test:
	:

# No-op: dh's clean would wipe the Makefile objects (full recompile on every `make deb`).
override_dh_auto_clean:
	:

override_dh_auto_install:
	# FHS layout resdir.h expects (same shape as the AppImage AppDir).
	install -D -m 755 "$(OSP_BIN)" debian/openspaceprogram/usr/bin/osp
	install -d debian/openspaceprogram/usr/share/openspaceprogram
	cp -a res debian/openspaceprogram/usr/share/openspaceprogram/res
